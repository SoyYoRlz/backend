# Puerto de escucha (en Render.com se asigna automáticamente mediante process.env.PORT)
PORT=3000

# Clave secreta para firmar los tokens HMAC-SHA256 (coloca una cadena larga y aleatoria)
SECRET_KEY=tu_clave_secreta_super_segura_para_firmar_tokens

# Clave de autorización que la aplicación móvil enviará en ?key=... para acceder a /playlist.m3u
APP_API_KEY=tu_clave_secreta_de_la_app
